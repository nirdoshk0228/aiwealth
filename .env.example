# Copy to .env and fill in. Never commit .env. Secrets are read only from the environment.

# --- API ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
# Optional: where universe.json, scenarios/, portfolios/ and the Parquet cache (raw/) live.
# DATA_DIR=C:/path/to/data

# --- Database (Neon Postgres in dev and prod; see README) ---
# Pooled connection string from the Neon console. psycopg 3 is used automatically.
DATABASE_URL=
# Optional non-pooled URL for Alembic migrations (falls back to DATABASE_URL).
DATABASE_URL_DIRECT=

# Market data source for request paths: auto (Postgres if DATABASE_URL is set), parquet, postgres
MARKET_DATA_BACKEND=auto
# Load market data in the background at startup (false in tests).
WARM_MARKET_DATA=true

# --- Auth ---
# At least 32 bytes; required when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- Knowledge base (RAG) ---
# RAG_MODE=hybrid               # dense | hybrid | hybrid_rerank
# RAG_BACKEND=auto              # auto (Postgres if DATABASE_URL) | local | postgres
# RAG_INDEX_DIR=                # default <repo>/data/docs/index
# RAG_MODEL_DIR=                # default <repo>/.cache/models (gitignored)

# --- CORS: comma-separated browser origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000

# --- LLM: any OpenAI-compatible chat API; Groq free tier by default ---
GROQ_API_KEY=                  # or LLM_API_KEY
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Chat rate limits (per client IP per window, and per instance per day)
# CHAT_RATE_LIMIT=8
# CHAT_RATE_WINDOW_SECONDS=60
# CHAT_DAILY_LIMIT=300
# AI trace (prompts, tool calls, retrieved chunks) as JSON lines; default <repo>/logs (gitignored)
# AI_TRACE_DIR=

# --- Optional local Postgres via docker-compose (not needed with Neon) ---
POSTGRES_USER=aiwealth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aiwealth
POSTGRES_PORT=5432
